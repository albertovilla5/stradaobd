# Plantilla de configuración de firma para Google Play Store (Upload Key)
# Copia este archivo a 'keystore.properties' (ignorado por Git) y rellena tus datos:
# Para generar el keystore:
# keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload

storeFile=upload-keystore.jks
storePassword=CAMBIAR_PASSWORD_KEYSTORE
keyAlias=upload
keyPassword=CAMBIAR_PASSWORD_CLAVE
